CLIENT_ID=
CLIENT_SECRET=
CLUB_ID=

# Start marker — activity that marks the beginning of the tracked period.
# All activities UP TO AND INCLUDING this one (in the club feed) will be counted.
# The feed is ordered newest-first, so this should be the oldest activity of the period.
# Note: Strava shows abbreviated last names in club feeds (e.g. "P." not "Petelj").
START_ATHLETE_FIRSTNAME=
START_ATHLETE_LASTNAME=
START_ACTIVITY_NAME=
START_DISTANCE_KM=
# Optional: add moving_time and elapsed_time (in seconds) for even more precise matching.
# Run the script once without these set to see the values in the activity listing.
START_MOVING_TIME=
START_ELAPSED_TIME=
